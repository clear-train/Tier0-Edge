{
  "appId": "openems",
  "direction": "bidirectional",
  "enabled": true,
  "mappings": [
    {
      "id": "tier0-to-openems-consumption",
      "name": "Tier0 consumption -> OpenEMS simulated consumption",
      "enabled": true,
      "tier0BaseUrl": "http://kong:8000",
      "tier0MqttUrl": "mqtt://emqx:1883",
      "tier0SourceType": "path",
      "tier0SourceValue": "State/openemsPower",
      "tier0Field": "value",
