      "openemsPassword": "admin",
      "valueType": "number",
      "pollIntervalMs": 5000,
      "scale": 1,
      "offset": 0
    }
  ],
  "feedbackEnabled": true,
  "feedbackMappings": [
    {
      "id": "openems-grid-active-power-state",
      "name": "OpenEMS Grid Active Power State",
      "enabled": true,
      "tier0MqttUrl": "mqtt://emqx:1883",
