      "tier0PayloadField": "value",
      "openemsSourceType": "channel",
      "openemsComponentId": "_sum",
      "openemsChannelId": "GridActivePower",
      "openemsUsername": "x",
      "openemsPassword": "user",
      "valueType": "number",
      "pollIntervalMs": 5000,
      "scale": 1,
      "offset": 0,
      "isa95Enterprise": "V1",
      "isa95Site": "Tier0Site",
      "isa95Area": "EnergyArea",
      "isa95Line": "OpenEMSLine",
      "isa95Cell": "EdgeCell",
      "isa95Asset": "OpenEMS",
      "isa95Category": "State",
      "isa95Tag": "gridActivePower"
    }
  ]
